# ============================================================
# TOKPa Frontend — Variables d'environnement (Vite)
# Copier vers .env.local et adapter à votre environnement.
# .env.local est ignoré par git (.gitignore).
# ============================================================

# Base URL de l'API Laravel (backend)
# Dev local (XAMPP) : http://localhost:8000/api
# En production : https://api.tokpa.bj/api
VITE_API_BASE_URL=http://localhost:8000/api

# Laravel Reverb (WebSocket) — valeurs par défaut du .env.example du backend
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_WSS_PORT=443
VITE_REVERB_SCHEME=ws
VITE_REVERB_KEY=tokpa-key
VITE_REVERB_APP_ID=tokpa

# Clé Google Maps — ne jamais la committer dans le dépôt.
# À créer dans Google Cloud > « Maps JavaScript API » (+ « Maps Embed API » si besoin), avec une
# facturation active et une restriction HTTP referrer vers votre domaine. Le frontend ne charge
# JAMAIS la clé depuis autre chose que cette variable : ni fichier, ni chaîne en dur.
# Vide = les cartes (suivi de course, zone du livreur) basculent sur le repli Leaflet/OpenStreetMap,
# avec une puce discrète sur la carte ; aucune requête Google n'est émise.
VITE_GOOGLE_MAPS_API_KEY=
