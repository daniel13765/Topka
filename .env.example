# Le navigateur appelle toujours /api ; Vite proxyfie ensuite vers Laravel.
VITE_API_URL=/api
VITE_BACKEND_URL=http://127.0.0.1:8000

# Laisser true pendant le développement frontend sans backend disponible.
VITE_USE_MOCKS=true

# À renseigner uniquement dans .env.local pour la carte Google Maps.
VITE_GOOGLE_MAPS_API_KEY=

# Reverb — à renseigner quand le backend Laravel est prêt.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
